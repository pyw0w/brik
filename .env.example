# Токен Discord-приложения (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Гильда для dev-режима: команды регистрируются на неё (мгновенные обновления).
# Без значения команды регистрируются глобально (кэш Discord, до минуты).
DISCORD_DEV_GUILD_ID=

# Имя файла конфига модулей (по умолчанию bot.config.ts)
# BOT_CONFIG_PATH=bot.config.ts
